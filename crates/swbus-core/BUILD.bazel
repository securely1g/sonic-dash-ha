load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//bazel:runtime.bzl", "ha_rust_test")
load("//bazel:rust.bzl", "RUST_FLAGS")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

_CARGO_ENV = {
    "CARGO_PKG_AUTHORS": "SONiC",
    "CARGO_PKG_DESCRIPTION": "SONiC Switch Bus",
    "CARGO_PKG_HOMEPAGE": "",
    "CARGO_PKG_NAME": "swbus-core",
    "CARGO_PKG_REPOSITORY": "https://github.com/sonic/sonic-dash-ha",
}

rust_library(
    name = "swbus_core",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "swbus_core",
    crate_root = "src/lib.rs",
    edition = "2021",
    proc_macro_deps = [
        "@sonic_rust_deps//:atomic_enum",
        "@sonic_rust_deps//:contracts",
        "@sonic_rust_deps//:derivative",
        "@sonic_rust_deps//:getset",
    ],
    rustc_env = _CARGO_ENV,
    rustc_flags = RUST_FLAGS,
    version = "0.1.0",
    deps = [
        "//crates/swbus-config:swbus_config",
        "//crates/swbus-proto:swbus_proto",
        "@sonic_rust_deps//:color-eyre",
        "@sonic_rust_deps//:dashmap",
        "@sonic_rust_deps//:futures-core",
        "@sonic_rust_deps//:hyper-util",
        "@sonic_rust_deps//:prost",
        "@sonic_rust_deps//:serde",
        "@sonic_rust_deps//:serde_json",
        "@sonic_rust_deps//:serde_yaml",
        "@sonic_rust_deps//:strum",
        "@sonic_rust_deps//:tempfile",
        "@sonic_rust_deps//:tokio",
        "@sonic_rust_deps//:tokio-stream",
        "@sonic_rust_deps//:tokio-util",
        "@sonic_rust_deps//:tonic",
        "@sonic_rust_deps//:tower",
        "@sonic_rust_deps//:tracing",
    ],
)

# Preserve the original crate unit tests; installed runners supply native
# runtime libraries and private Redis/fixture working directories.
rust_test(
    name = "unit_test_binary",
    crate = ":swbus_core",
    experimental_use_cc_common_link = 1,
    tags = ["manual"],
    deps = [
        "//crates/sonic-common:sonic_common",
        "//crates/swbus-edge:swbus_edge",
        "@sonic_rust_deps//:lazy_static",
        "@sonic_rust_deps//:pretty_assertions",
        "@sonic_rust_deps//:tracing-subscriber",
    ],
)

