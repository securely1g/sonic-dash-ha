load("@rules_rs//rs:cargo_build_script.bzl", "cargo_build_script")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//bazel:runtime.bzl", "ha_rust_test")
load("//bazel:rust.bzl", "RUST_FLAGS")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

_CARGO_ENV = {
    "CARGO_PKG_AUTHORS": "SONiC",
    "CARGO_PKG_DESCRIPTION": "",
    "CARGO_PKG_HOMEPAGE": "",
    "CARGO_PKG_NAME": "sonic-dash-api-proto",
    "CARGO_PKG_REPOSITORY": "https://github.com/sonic/sonic-dash-ha",
}

# Keep the original build.rs paths while sourcing the exact owner schema.
genrule(
    name = "schema_inputs",
    srcs = ["@sonic_dash_api//:ha_schema_sources"],
    outs = [
        "sonic-dash-api/proto/ha_scope_config.proto",
        "sonic-dash-api/proto/ha_set_config.proto",
        "sonic-dash-api/proto/types.proto",
    ],
    cmd = "mkdir -p $(@D)/sonic-dash-api/proto; for source in $(locations @sonic_dash_api//:ha_schema_sources); do cp $$source $(@D)/sonic-dash-api/proto/$$(basename $$source); done",
)

cargo_build_script(
    name = "generate",
    srcs = ["build.rs"],
    build_script_env = {"PROTOC": "$(execpath @protobuf_legacy//:protoc)"},
    crate_root = "build.rs",
    data = [":schema_inputs"],
    edition = "2021",
    tools = ["@protobuf_legacy//:protoc"],
    version = "0.1.0",
    deps = [
        "@sonic_rust_deps//:prost-build",
    ],
)

rust_library(
    name = "sonic_dash_api_proto",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "sonic_dash_api_proto",
    crate_root = "src/lib.rs",
    edition = "2021",
    proc_macro_deps = [
        "//crates/sonicdb-derive:sonicdb_derive",
        "@sonic_rust_deps//:strum_macros",
    ],
    rustc_env = _CARGO_ENV,
    rustc_flags = RUST_FLAGS,
    version = "0.1.0",
    deps = [
        ":generate",
        "//crates/sonic-common:sonic_common",
        "@sonic_rust_deps//:hex",
        "@sonic_rust_deps//:prost",
        "@sonic_rust_deps//:serde",
        "@sonic_rust_deps//:serde_json",
        "@sonic_rust_deps//:strum",
        "@sonic_swss_common//crates/swss-common:swss_common_async",
    ],
)

# Preserve the original crate unit tests; installed runners supply native
# runtime libraries and private Redis/fixture working directories.
rust_test(
    name = "unit_test_binary",
    crate = ":sonic_dash_api_proto",
    experimental_use_cc_common_link = 1,
    tags = ["manual"],
    deps = [
    ],
)

ha_rust_test(
    name = "unit_test",
    binary = ":unit_test_binary",
    fixtures = glob(
        ["tests/**/*.json"],
        allow_empty = True,
    ),
)
