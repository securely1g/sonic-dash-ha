load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//bazel:runtime.bzl", "ha_rust_test")
load("//bazel:rust.bzl", "RUST_FLAGS")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

_CARGO_ENV = {
    "CARGO_PKG_AUTHORS": "SONiC",
    "CARGO_PKG_DESCRIPTION": "SONiC Switch Bus CLI",
    "CARGO_PKG_HOMEPAGE": "",
    "CARGO_PKG_NAME": "swbus-cli",
    "CARGO_PKG_REPOSITORY": "https://github.com/sonic/sonic-dash-ha",
}

rust_binary(
    name = "swbus_cli",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "swbus_cli",
    crate_root = "src/main.rs",
    edition = "2021",
    experimental_use_cc_common_link = 1,
    rustc_env = _CARGO_ENV,
    rustc_flags = RUST_FLAGS,
    version = "0.1.0",
    deps = [
        "//crates/swbus-actor:swbus_actor",
        "//crates/swbus-config:swbus_config",
        "//crates/swbus-core:swbus_core",
        "//crates/swbus-edge:swbus_edge",
        "//crates/swbus-proto:swbus_proto",
        "@sonic_rust_deps//:anyhow",
        "@sonic_rust_deps//:chrono",
        "@sonic_rust_deps//:clap",
        "@sonic_rust_deps//:serde_json",
        "@sonic_rust_deps//:serde_yaml",
        "@sonic_rust_deps//:tabled",
        "@sonic_rust_deps//:tokio",
        "@sonic_rust_deps//:tokio-stream",
        "@sonic_rust_deps//:tonic",
        "@sonic_rust_deps//:tracing",
        "@sonic_rust_deps//:tracing-subscriber",
        "@sonic_rust_deps//:uuid",
    ],
)

# Preserve the original crate unit tests; installed runners supply native
# runtime libraries and private Redis/fixture working directories.
rust_test(
    name = "unit_test_binary",
    crate = ":swbus_cli",
    experimental_use_cc_common_link = 1,
    tags = ["manual"],
    deps = [
        "//crates/swss-serde:swss_serde",
        "@sonic_swss_common//crates/swss-common:swss_common_async",
        "@sonic_swss_common//crates/swss-common-testing:swss_common_testing_async",
    ],
)

ha_rust_test(
    name = "unit_test",
    binary = ":unit_test_binary",
    fixtures = glob(
        ["tests/**/*.json"],
        allow_empty = True,
    ),
)
