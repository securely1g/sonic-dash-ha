load("@rules_rs//rs:cargo_build_script.bzl", "cargo_build_script")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//bazel:runtime.bzl", "ha_rust_test")
load("//bazel:rust.bzl", "RUST_FLAGS")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

_CARGO_ENV = {
    "CARGO_PKG_AUTHORS": "SONiC",
    "CARGO_PKG_DESCRIPTION": "",
    "CARGO_PKG_HOMEPAGE": "",
    "CARGO_PKG_NAME": "swbus-proto",
    "CARGO_PKG_REPOSITORY": "https://github.com/sonic/sonic-dash-ha",
}

cargo_build_script(
    name = "generate",
    srcs = ["build.rs"],
    build_script_env = {"PROTOC": "$(execpath @protobuf_legacy//:protoc)"},
    crate_root = "build.rs",
    data = ["proto/swbus.proto"],
    edition = "2021",
    tools = ["@protobuf_legacy//:protoc"],
    version = "0.1.0",
    deps = [
        "@sonic_rust_deps//:tonic-build",
    ],
)

rust_library(
    name = "swbus_proto",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "swbus_proto",
    crate_root = "src/lib.rs",
    edition = "2021",
    proc_macro_deps = [
        "@sonic_rust_deps//:contracts",
    ],
    rustc_env = _CARGO_ENV,
    rustc_flags = RUST_FLAGS,
    version = "0.1.0",
    deps = [
        ":generate",
        "@sonic_rust_deps//:prost",
        "@sonic_rust_deps//:serde",
        "@sonic_rust_deps//:serde_json",
        "@sonic_rust_deps//:strum",
        "@sonic_rust_deps//:thiserror",
        "@sonic_rust_deps//:tonic",
    ],
)

# Preserve the original crate unit tests; installed runners supply native
# runtime libraries and private Redis/fixture working directories.
rust_test(
    name = "unit_test_binary",
    crate = ":swbus_proto",
    experimental_use_cc_common_link = 1,
    tags = ["manual"],
    deps = [
        "@sonic_rust_deps//:pretty_assertions",
    ],
)

ha_rust_test(
    name = "unit_test",
    binary = ":unit_test_binary",
    fixtures = glob(
        ["tests/**/*.json"],
        allow_empty = True,
    ),
)
