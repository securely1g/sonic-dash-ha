load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//bazel:runtime.bzl", "ha_rust_test")
load("//bazel:rust.bzl", "RUST_FLAGS")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

_CARGO_ENV = {
    "CARGO_PKG_AUTHORS": "SONiC",
    "CARGO_PKG_DESCRIPTION": "",
    "CARGO_PKG_HOMEPAGE": "",
    "CARGO_PKG_NAME": "swss-common-bridge",
    "CARGO_PKG_REPOSITORY": "https://github.com/sonic/sonic-dash-ha",
}

rust_library(
    name = "swss_common_bridge",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "swss_common_bridge",
    crate_root = "src/lib.rs",
    edition = "2021",
    proc_macro_deps = [
        "//crates/sonicdb-derive:sonicdb_derive",
    ],
    rustc_env = _CARGO_ENV,
    rustc_flags = RUST_FLAGS,
    version = "0.1.0",
    deps = [
        "//crates/sonic-common:sonic_common",
        "//crates/sonic-dash-api-proto:sonic_dash_api_proto",
        "//crates/swbus-actor:swbus_actor",
        "//crates/swbus-edge:swbus_edge",
        "@sonic_rust_deps//:anyhow",
        "@sonic_rust_deps//:hex",
        "@sonic_rust_deps//:prost",
        "@sonic_rust_deps//:serde",
        "@sonic_rust_deps//:serde_json",
        "@sonic_rust_deps//:tokio",
        "@sonic_rust_deps//:tokio-util",
        "@sonic_rust_deps//:tracing",
        "@sonic_swss_common//crates/swss-common:swss_common_async",
    ],
)

# Preserve the original crate unit tests; installed runners supply native
# runtime libraries and private Redis/fixture working directories.
rust_test(
    name = "unit_test_binary",
    crate = ":swss_common_bridge",
    experimental_use_cc_common_link = 1,
    tags = ["manual"],
    deps = [
        "@sonic_swss_common//crates/swss-common-testing:swss_common_testing_async",
    ],
)

ha_rust_test(
    name = "unit_test",
    binary = ":unit_test_binary",
    fixtures = glob(
        ["tests/**/*.json"],
        allow_empty = True,
    ),
)
