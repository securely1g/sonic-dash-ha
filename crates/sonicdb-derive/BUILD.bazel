load("@rules_rs//rs:rust_proc_macro.bzl", "rust_proc_macro")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//bazel:runtime.bzl", "ha_rust_test")
load("//bazel:rust.bzl", "RUST_FLAGS")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

_CARGO_ENV = {
    "CARGO_PKG_AUTHORS": "SONiC",
    "CARGO_PKG_DESCRIPTION": "",
    "CARGO_PKG_HOMEPAGE": "",
    "CARGO_PKG_NAME": "sonicdb-derive",
    "CARGO_PKG_REPOSITORY": "https://github.com/sonic/sonic-dash-ha",
}

rust_proc_macro(
    name = "sonicdb_derive",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "sonicdb_derive",
    crate_root = "src/lib.rs",
    edition = "2021",
    rustc_env = _CARGO_ENV,
    rustc_flags = RUST_FLAGS,
    version = "0.1.0",
    deps = [
        "@sonic_rust_deps//:proc-macro2",
        "@sonic_rust_deps//:quote",
        "@sonic_rust_deps//:syn",
    ],
)

rust_test(
    name = "basic_test_binary",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/basic.rs",
    data = glob(
        ["tests/**/*.json"],
        allow_empty = True,
    ),
    edition = "2021",
    experimental_use_cc_common_link = 1,
    proc_macro_deps = [
        ":sonicdb_derive",
    ],
    rustc_env = _CARGO_ENV,
    tags = ["manual"],
    deps = [
        "//crates/sonic-common:sonic_common",
        "@sonic_rust_deps//:proc-macro2",
        "@sonic_rust_deps//:quote",
        "@sonic_rust_deps//:syn",
        "@sonic_swss_common//crates/swss-common:swss_common_async",
    ],
)

ha_rust_test(
    name = "basic_test",
    binary = ":basic_test_binary",
    fixtures = glob(
        ["tests/**/*.json"],
        allow_empty = True,
    ),
)
