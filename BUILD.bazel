load("@sonic_build_infra//oci:runtime_packages.bzl", "runtime_packages")
load("@sonic_build_infra//tar:sonic_deploy_tar.bzl", "sonic_deploy_tar")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.toml",
    "Cargo.lock",
    "debian/control",
    "debian/changelog",
    "debian/install",
])

# This is the native debian/install payload; container is a build utility and
# remains a separate source target, not an installed fourth service.
sonic_deploy_tar(
    name = "dash_ha_pkg",
    srcs = ["scripts/wait_for_loopback.py"],
    binaries = {
        "usr/bin/hamgrd uid=0 gid=0 mode=0755 type=file": "//crates/hamgrd:hamgrd",
        "usr/bin/swbusd uid=0 gid=0 mode=0755 type=file": "//crates/swbusd:swbusd",
        "usr/bin/swbus-cli uid=0 gid=0 mode=0755 type=file": "//crates/swbus-cli:swbus_cli",
    },
    default_mtime = "1686772800",
    force_debug_build = True,
    mtree = ["usr/bin/wait_for_loopback.py uid=0 gid=0 mode=0755 type=file content=$(location scripts/wait_for_loopback.py)"],
    visibility = ["//visibility:public"],
)

# Describes installed source TARs; this target does not create a Debian package.
runtime_packages(
    name = "runtime_packages.json",
    changelog = "debian/changelog",
    control = "debian/control",
    dependencies = ["@sonic_swss_common//:runtime_packages.json"],
    packages = {"dash-ha": ":dash_ha_pkg"},
    required_paths = {"dash-ha": [
        "usr/bin/hamgrd",
        "usr/bin/swbusd",
        "usr/bin/swbus-cli",
        "usr/bin/wait_for_loopback.py",
    ]},
)
